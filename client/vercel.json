{
  "framework": "vite",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://civicresolve-8nve.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://civicresolve-8nve.onrender.com/uploads/$1"
    },
    {
      "source": "/((?!api/|uploads/|assets/|sw\\.js|civicresolve-logo\\.png|favicon\\.svg|icons\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}

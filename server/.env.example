# CivicResolve Backend Configuration
PORT=5000
NODE_ENV=development

# ==============================================================================
# PRODUCTION CORS & FRONTEND URL CONFIGURATION
# ==============================================================================
# In production, set to your frontend deployment URL (e.g., https://civicresolve-yc9v.onrender.com)
FRONTEND_URL=https://civicresolve-yc9v.onrender.com
CORS_ORIGIN=https://civicresolve-yc9v.onrender.com

# ==============================================================================
# PERSISTENT STORAGE PATHS (Supports Render Persistent Disks / Docker Volumes)
# ==============================================================================
# Base directory for persistent data (defaults to server root if unset)
# DATA_DIR=/var/data
# Path to SQLite database file (defaults to civicresolve.db inside DATA_DIR or server root)
# SQLITE_DB_PATH=/var/data/civicresolve.db
# Directory where user uploaded grievance photos are saved
# UPLOADS_DIR=/var/data/uploads

# ==============================================================================
# GOOGLE CLOUD & GEMINI AI CONFIGURATION (PRIMARY AI ENGINE)
# ==============================================================================
# Google Gemini API Key (Powered by Official @google/genai SDK)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Google Maps Platform API Key (Interactive Geocoding & Maps JS API)
# Get key at: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google reCAPTCHA v2/v3 Configuration
# Get keys at: https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here
RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Optional Alternate AI Fallback
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# JSON Web Token Secret (Required for secure administrator & citizen sessions)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
OTP_SALT=replace_with_a_secure_random_salt_for_otp_hashing

# Initial Master Administrator Seed Credentials
INITIAL_ADMIN_EMAIL=admin@civicresolve.gov
INITIAL_ADMIN_PASSWORD=your_initial_secure_admin_password
INITIAL_ADMIN_NAME=Director of Municipal Operations

# ==============================================================================
# FREE-FIRST NOTIFICATION ENGINE (RESEND EMAIL + WEB PUSH VAPID + IN-APP)
# ==============================================================================
# 1. Official Resend Email SDK (https://resend.com/ - Free tier: 3,000 emails/mo)
EMAIL_ENABLED=true
RESEND_API_KEY=re_your_resend_api_key_here
# Use your verified custom domain in production, or onboarding@resend.dev for initial Resend free-tier testing
EMAIL_FROM=CivicResolve <onboarding@resend.dev>

# 2. Browser Web Push Notifications (Standard Open VAPID Protocol - Completely Free)
# Generate keys via: npx web-push generate-vapid-keys
WEB_PUSH_ENABLED=true
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:grievance@civicresolve.gov

# Optional SMTP Fallback (Used only when RESEND_API_KEY is unset and SMTP credentials are provided)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
